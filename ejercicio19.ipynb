      "[12, 4, 22, 18, 10, 6, 20, 16, 8, 14]\n"
     ]
    }
   ],
   "source": [
    "numeros = [12, 7, 4, 15, 22, 9, 18, 3, 10, 25, 6, 13, 20, 1, 16, 11, 8, 19, 14, 5]\n",
    "\n",
    "resultado = list(filter(lambda numero: numero % 2 == 0, numeros)) \n",
    "\n",
    "print(resultado)"
   ]
  }
