   "source": [
    "Enunciado:\n",
    "\n",
    "Crea una función lambda que calcule el resto de la división entre dos números dados."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "5388c67f",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "1\n"
     ]
    }
   ],
   "source": [
    "def resto_division(numero1, numero2):\n",
    "    funcion_lambda = lambda numero1, numero2: numero1 % numero2\n",
    "\n",
    "    return funcion_lambda(numero1, numero2)\n",
    "\n",
    "print(resto_division(17, 2))"
   ]
  }
