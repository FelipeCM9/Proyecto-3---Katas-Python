   "source": [
    "Enunciado:\n",
    "\n",
    "Crea una función lambda que sume 3 a cada número de una lista dada.jer"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "9ab21146",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "[7, 10, 15, 6, 12, 18, 5, 11, 23, 9]"
      ]
     },
     "execution_count": 1,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "def suma_lambda(lista_numeros):\n",
    "    return list(map(lambda numero: numero + 3, lista_numeros))\n",
    "\n",
    "suma_lambda([4, 7, 12, 3, 9, 15, 2, 8, 20, 6])"
   ]
  }
